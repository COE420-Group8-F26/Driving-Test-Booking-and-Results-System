
@startuml
title Driving Test Booking and Results System\nSoftware Architecture Component Diagram - Group 8

top to bottom direction

skinparam backgroundColor white
skinparam shadowing false
skinparam componentStyle uml2
skinparam packageStyle rectangle
skinparam linetype ortho
skinparam defaultFontName Arial
skinparam defaultFontSize 12
skinparam nodesep 20
skinparam ranksep 35
skinparam ArrowColor #64748B
skinparam componentBackgroundColor white
skinparam componentBorderColor #334155
skinparam interfaceBorderColor #2563EB
skinparam packageBorderColor #64748B
skinparam noteBackgroundColor #FFFDF3
skinparam noteBorderColor #CBD5E1
skinparam wrapWidth 230

package "Layer 1 - Presentation" #EAF3FF {
  component "CO1\nWeb User Interface" as UI
}

package "Layer 2 - Application" #EAF8F0 {
  component "CO2\nAccount and Access Control" as ACC
  component "CO3\nBooking and Scheduling" as BSC
  component "CO4\nResults and Certification" as RSC
  component "CO5\nNotification and Audit" as NAC

  ACC -[hidden]right- BSC
  ACC -[hidden]down- RSC
  BSC -[hidden]down- NAC
  RSC -[hidden]right- NAC
}

package "Layer 3 - Data" #FFF3E8 {
  component "CO6\nData Management" as DATA
}

() "IAccountService" as IA
() "IAccessControlService" as IX
() "IBookingService" as IB
() "ISchedulingService" as IS
() "IResultService" as IR
() "INotificationService" as IN
() "IAuditService" as IT
() "IAccountData" as IAD
() "IBookingData" as IBD
() "IScheduleData" as ISD
() "IResultData" as IRD
() "INotificationData" as IND

ACC - IA
ACC - IX
BSC - IB
BSC - IS
RSC - IR
NAC - IN
NAC - IT

DATA - IAD
DATA - IBD
DATA - ISD
DATA - IRD
DATA - IND

UI -u-( IA
UI -u-( IX
UI -u-( IB
UI -u-( IS
UI -u-( IR
UI -u-( IN

BSC -l-( IX
RSC -l-( IX

BSC -d-( IN
BSC -d-( IT
RSC -d-( IN
RSC -d-( IT

ACC -d-( IAD

BSC -d-( IBD
BSC -d-( ISD

RSC -d-( IBD
RSC -d-( ISD
RSC -d-( IRD

NAC -d-( IND

cloud "Email Service" as EMAIL
database "Relational Database" as DB

ACC ..> EMAIL : reset links
NAC ..> EMAIL : notifications
DATA --> DB : read/write

